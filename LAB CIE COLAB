        "\n",
        "leaf_nodes = [10, 9, 14, 18, 5, 4, 50, 3]\n",
        "tree = [\n",
        "    [\n",
        "        [leaf_nodes[0], leaf_nodes[1]],  # Children of the first node at depth 2\n",
        "        [leaf_nodes[2], leaf_nodes[3]]   # Children of the second node at depth 2\n",
        "    ],\n",
        "    [\n",
        "        [leaf_nodes[4], leaf_nodes[5]],  # Children of the third node at depth 2\n",
        "        [leaf_nodes[6], leaf_nodes[7]]   # Children of the fourth node at depth 2\n",
        "    ]\n",
        "]\n",
        "\n",
        "print(tree)"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "def alpha_beta_with_path_and_pruning(node, depth, alpha, beta, maximizing_player, current_path=[], pruned_paths=[]):\n",
        "    \"\"\"\n",
        "    Implements the alpha-beta pruning algorithm and returns the optimal value, path, and pruned paths.\n",
        "\n",
        "    Args:\n",
        "        node: The current node (or subtree).\n",
        "        depth: The current depth of the search.\n",
        "        alpha: The current alpha value.\n",
        "        beta: The current beta value.\n",
        "        maximizing_player: True if it's the maximizing player's turn, False otherwise.\n",
        "        current_path: The path from the root to the current node.\n",
        "        pruned_paths: A list to store the paths that were pruned.\n",
        "\n",
        "    Returns:\n",
        "        A tuple containing the optimal value of the node, the path leading to it, and the list of pruned paths.\n",
        "    \"\"\"\n",
        "    if depth == 0:\n",
        "        return node, current_path + [node], pruned_paths\n",
        "\n",
        "    if maximizing_player:\n",
        "        best_value = -float('inf')\n",
        "        best_path = []\n",
        "        for i, child in enumerate(node):\n",
        "            child_path = current_path + [i] # Append index to represent the child node\n",
        "            value, path, pruned_paths = alpha_beta_with_path_and_pruning(child, depth - 1, alpha, beta, False, child_path, pruned_paths)\n",
        "            if value > best_value:\n",
        "                best_value = value\n",
        "                best_path = path\n",
        "            alpha = max(alpha, best_value)\n",
        "            if alpha >= beta:\n",
        "                # Beta cut-off\n",
        "                pruned_paths.append(current_path + [i]) # Record the path that was pruned\n",
        "                break\n",
        "        return best_value, best_path, pruned_paths\n",
        "    else:\n",
        "        best_value = float('inf')\n",
        "        best_path = []\n",
        "        for i, child in enumerate(node):\n",
        "            child_path = current_path + [i] # Append index to represent the child node\n",
        "            value, path, pruned_paths = alpha_beta_with_path_and_pruning(child, depth - 1, alpha, beta, True, child_path, pruned_paths)\n",
        "            if value < best_value:\n",
        "                best_value = value\n",
        "                best_path = path\n",
        "            beta = min(beta, best_value)\n",
        "            if alpha >= beta:\n",
        "                # Alpha cut-off\n",
        "                pruned_paths.append(current_path + [i]) # Record the path that was pruned\n",
        "                break\n",
        "        return best_value, best_path, pruned_paths\n",
        "\n",
        "optimal_value, optimal_path, pruned_paths = alpha_beta_with_path_and_pruning(tree, 3, -float('inf'), float('inf'), True)\n",
        "\n",
        "print(f\"The optimal value of the root node is: {optimal_value}\")\n",
        "print(f\"The path to the optimal value is: {optimal_path}\")\n",
        "print(f\"Pruned paths: {pruned_paths}\")\n"
